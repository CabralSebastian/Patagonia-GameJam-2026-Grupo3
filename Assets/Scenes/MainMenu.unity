  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Patagonia Game Jam 2026 \u2014 Grupo 3\r\nEjes: flujo del agua \u2014
    territorio y desarrollo\r\n\r\nEquipo\r\nCabral Sebasti\xE1n \u2014 Mizuki (Agu)
    \u2014 Celis Mart\xEDn \u2014 Espacio Vectorial (vektorspaco)\r\n\r\nM\xFAsica\r\n\"Perdido
    en la Estepa\" \u2014 Patagonia Oscura\r\nSello: Rusty Pilgrim Records \xB7 Autor:
    Miguel Molins\r\npatagoniaoscura.bandcamp.com\r\nUsado con autorizaci\xF3n expresa
    del autor.\r\n\r\nPaisaje en la ventana\r\n\"A Big Tree Swaying by the Wind Under
    Blue Sky\" \u2014 Jan Zakelj\r\nVer en Pexels \xB7 Licencia Pexels (uso gratuito
    con restricciones, atribuci\xF3n no requerida)\r\nUbicaci\xF3n seg\xFAn el autor:
    Santa Cruz, Patagonia, Argentina\r\nImagen modificada: vectorizada para el juego.\r\n\r\nEfectos
    de sonido\r\nRepositorio: freesound.org \u2014 Licencia CC0\r\n\r\nNotificaci\xF3n
    urgente \u2014 715069 \u2014 xkeril \u2014 \"end-of-task-notification\"\r\nNotificaci\xF3n
    de chat \u2014 844798 \u2014 nightdrawr \u2014 \"notification\"\r\nPresionar
    bot\xF3n \u2014 788611 \u2014 el_boss \u2014 \"ui-button-press\"\r\nInicio de
    partida \u2014 827123 \u2014 xkeril \u2014 \"startup-sound-computer\"\r\nFin
    de partida \u2014 827122 \u2014 xkeril \u2014 \"end-of-task-sound\"\r\nAgua corriendo
    \u2014 776548 \u2014 frenkfurth \u2014 \"water-from-pipe-5\"\r\nTanque vaciado
    \u2014 80932 \u2014 nigelcoop \u2014 \"drain-gurgle-1-1\"\r\nGota \u2014 863461
    \u2014 robo9418 \u2014 \"low-quality-water-drop\"\r\nApertura de compuerta \u2014
    815493 \u2014 xkeril \u2014 \"mechanical-switch-latch-02\"\r\nM\xE1ximo alcanzado
    \u2014 737284 \u2014 qubodup \u2014 \"key-locking-door\"\r\nTipograf\xEDa\r\nEssays
    1743 v0.2 \u2014 John Stracke\r\nGNU Lesser General Public License 2.1 \xB7 Ver
    licencia\r\nUsada sin modificaciones. El c\xF3digo fuente de la tipograf\xEDa
    (archivos .sfd) est\xE1 disponible en el sitio del autor: thibault.org/fonts/essays\r\n\r\nHerramientas\r\nUnity
    6.3 LTS\r\n\r\nAgradecimientos\r\nA la organizaci\xF3n de la Patagonia Game Jam
    2026, por armar el evento y los equipos.\r\n\r\nA HeimonD (Manu), por acercar
    su banco de assets sonoros, dar una mano con el loopeado del track y acompa\xF1ar
    el proyecto.\r\n\r\nUso de IA\r\nNing\xFAn asset del juego ha sido generado por
    IA, incluyendo los asset de terceros.\nSe utiliz\xF3 de forma auxiliar Claude
    Opus 5 para documentaci\xF3n interna del proyecto en la etapa de prototipado.
    Se us\xF3 para corroborar de forma exhaustiva el cumplimiento de licencias de
    uso."
  m_isRightToLeft: 0
